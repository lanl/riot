#ifndef RIOT_LIMITS_HPP_
#define RIOT_LIMITS_HPP_
// This file was made in part with generative AI.
// This file is auto-generated by CMake from riot_limits.hpp.in. Do not edit it directly;
// set RIOT_MAX_MATERIALS, RIOT_MAX_STRONG, RIOT_MAX_ADV, and RIOT_MAX_GROUPS at configure
// time.

namespace RiotLimits {
// Compile-time upper bounds baked in at configure time.
// NOTE(@pdmullen): MAX_ADV probably belongs in advection.hpp, and MAX_GROUPS in the
// radiation_diffusion package, but I thought it better to have all of these in the same
// place so that when we lift these compile time restrictions, it is an easier changeset.
constexpr int MAX_MATERIALS = @RIOT_MAX_MATERIALS@; // max materials co-located on a block
constexpr int MAX_STRONG = @RIOT_MAX_STRONG@;       // max strength materials
constexpr int MAX_ADV = @RIOT_MAX_ADV@;             // max advected quantities
constexpr int MAX_GROUPS = @RIOT_MAX_GROUPS@;       // max radiation energy groups
} // namespace RiotLimits

#endif // RIOT_LIMITS_HPP_
